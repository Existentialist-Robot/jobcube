# Dependencies
node_modules/
bun.lock

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Compiled documents (LaTeX output — exclude)
*.pdf
# ...but DO track exported application PDFs in working/exports/
!working/exports/**/*.pdf
*.aux
*.log
*.out
*.synctex.gz
*.fls
*.fdb_latexmk

# Personal data (never commit these)
salary_data.json
job_scraper/seen_jobs.json
job_scraper/*.md
*_BehavioralReport.pdf
linkedin_Profile.pdf

# Private intake: ignore everything you drop in documents/, but keep the
# folder structure tracked so the layout survives a fresh clone.
documents/**
!documents/**/
!documents/README.md
!documents/**/.gitkeep

# Generated visualizations are build output — rebuild with
# working/scripts/viz/build_job_viz_three.py rather than committing 100+ KB of
# regenerable HTML that conflicts on every merge.
working/active/*.html
# ...and the dated backups the builder makes of the previous viz.
working/archive/viz/*.html
# ...and the three.js copy the builder places beside the output. The tracked
# original lives in assets/vendor/; this is a build artifact.
working/active/vendor/

# Outreach logs name real third-party people (hiring managers, panellists).
# Keep the folder structure; never commit the logs themselves.
working/outreach/**
!working/outreach/**/
!working/outreach/.gitkeep
!working/outreach/README.md

# Personal photos and signatures
*.jpg
*.jpeg
*.png
!cover_letters/OpenFonts/fonts/**
# ...but brand assets are the repo's own artwork, not personal photos.
!assets/*.png

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Memory files (Claude Code user-specific)
.claude/projects/

# Skills lock (auto-generated)
skills-lock.json
.env
